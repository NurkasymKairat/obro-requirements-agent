# Скопируйте в .env.prod (в этой же папке) и заполните. .env.prod не попадает в git.

# Провайдер модели: gemini (по умолчанию) или openai
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol
# запасные модели через запятую (значение по умолчанию агента); пустое значение — без запасных
OPENAI_FALLBACK_MODELS=gpt-6-luna

# Gemini (если LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Название продукта в интерфейсе
WEB_TITLE=ТЗ Контроль

# Кеш ответов модели — именованный том из compose.yaml
CACHE_DIR=/data/cache

# real — настоящий прогон; stub — заглушка без модели (проверка без ключа)
WEB_PIPELINE=real
