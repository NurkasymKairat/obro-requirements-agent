# Настройки агента. Скопируйте файл в .env и впишите ключ: cp .env.example .env
# Пустое значение = значение по умолчанию (кроме *_FALLBACK_MODELS: пустое значение отключает запасные модели).
# Переменная, заданная в оболочке, важнее строки в этом файле. Каждую переменную пишите один раз.

# --- Провайдер ---
# gemini (по умолчанию) или openai
LLM_PROVIDER=gemini

# --- Gemini ---
# Ключ: https://aistudio.google.com/apikey («Create API key»). Подходит бесплатный тариф.
GEMINI_API_KEY=
# Основная модель
GEMINI_MODEL=gemini-3.8-flash
# Запасные модели через запятую: после 3 неудачных повторов (503, 429) или при исчерпанной дневной квоте
# агент переходит к следующей и остаётся на ней до конца прогона
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash
# Запросов в минуту: не выше лимита тарифа (бесплатный — 10). Агент выдерживает паузу 60/RPM секунд между вызовами
GEMINI_RPM=10
# Температура генерации: 0 — минимальная вариативность (seed фиксирован в коде)
GEMINI_TEMPERATURE=0
# Потолок рассуждения. Уровень задаётся по проходам (THINKING: off | low | medium | high; off и low — "low").
# 0 — все проходы в off. Модели Gemini 3 не соблюдают бюджет в токенах, поэтому иное значение не ограничивает
# рассуждение точно. Рассуждение оплачивается как выход
GEMINI_THINKING_BUDGET=2048
# Предел длины ответа модели, токенов
GEMINI_MAX_OUTPUT_TOKENS=32768

# --- OpenAI (необязательно, включается LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol
OPENAI_FALLBACK_MODELS=gpt-6-luna
# Глубина рассуждений: none, minimal, low, medium, high, xhigh. temperature для OpenAI не задаётся
OPENAI_REASONING_EFFORT=medium
OPENAI_RPM=60
OPENAI_MAX_OUTPUT_TOKENS=32768

# --- Общие ---
# Одновременных вызовов модели: независимые проходы и пачки идут параллельно. 3 укладывается в лимит
# запросов в минуту бесплатного тарифа; 1 — строго по очереди
AGENT_CONCURRENCY=3
# Тайм-аут одного запроса к модели, секунд (оба провайдера). После истёкшего тайм-аута —
# один повтор на той же модели, затем запасная модель. AGENT_TIMEOUT — проходы с минимальным рассуждением (нарезка, проверка
# каждого требования); AGENT_TIMEOUT_THINKING — проходы с рассуждением medium или high (сверки, ревью)
AGENT_TIMEOUT=90
AGENT_TIMEOUT_THINKING=360
# Повторов на одной модели до перехода на запасную
LLM_RETRIES_PER_MODEL=3
# Кеш ответов модели: прерванный прогон продолжается с последнего успешного вызова.
# Ответ берётся из кеша только для той же модели и тех же параметров генерации
CACHE_DIR=.cache/llm
# 1 — показывать стектрейс внутренних ошибок
AGENT_DEBUG=
